            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"AllowALBLogDelivery\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:PutObject\",\n      \"Resource\": \"arn:aws:s3:::lab-api-prod-alb-access-logs-948806325010/alb-access-logs/AWSLogs/948806325010/*\",\n      \"Principal\": {\n        \"AWS\": \"arn:aws:iam::127311923021:root\"\n      }\n    },\n    {\n      \"Sid\": \"AllowALBLogDeliveryServicePrincipal\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:PutObject\",\n      \"Resource\": \"arn:aws:s3:::lab-api-prod-alb-access-logs-948806325010/alb-access-logs/AWSLogs/948806325010/*\",\n      \"Principal\": {\n        \"Service\": \"logdelivery.elasticloadbalancing.amazonaws.com\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"s3:x-amz-acl\": \"bucket-owner-full-control\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"AllowALBLogDelivery\",\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::lab-api-prod-alb-access-logs-948806325010/alb-access-logs/AWSLogs/948806325010/*\",\"Principal\":{\"AWS\":\"arn:aws:iam::127311923021:root\"}},{\"Sid\":\"AllowALBLogDeliveryServicePrincipal\",\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::lab-api-prod-alb-access-logs-948806325010/alb-access-logs/AWSLogs/948806325010/*\",\"Principal\":{\"Service\":\"logdelivery.elasticloadbalancing.amazonaws.com\"},\"Condition\":{\"StringEquals\":{\"s3:x-amz-acl\":\"bucket-owner-full-control\"}}}]}",
            "override_json": null,
